@page
@model week5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">

            <h5 class="mb-0">
                <i class="bi bi-journal-plus"></i> Add/Edit Class
            </h5>

            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="EditId" />
                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input type="text" class="form-control" asp-for="ClassInfo.ClassName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input type="number" class="form-control" asp-for="ClassInfo.StudentCount" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" asp-for="ClassInfo.Description" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Save</button>
                </form>
            </div>
        </div>


        <div class="col-md-6">
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control"
                        placeholder="Search by class name..." />
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </form>

            <div class="mb-3">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="columns" value="ClassName" id="col1" checked>
                    <label class="form-check-label" for="col1">Class Name</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="columns" value="StudentCount" id="col2"
                        checked>
                    <label class="form-check-label" for="col2">Student Count</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="columns" value="Description" id="col3"
                        checked>
                    <label class="form-check-label" for="col3">Description</label>
                </div>

                <button type="button" class="btn btn-primary w-100 mt-2" onclick="downloadJson(false)">Export All(JSON)</button>
                <button type="button" class="btn btn-primary w-100 mt-2" onclick="downloadJson(true)">Export Filtered (JSON)</button>
            </div>

            <script>
                function downloadJson(isFiltered) {
                    const selected = [];
                    document.querySelectorAll('input[name="columns"]:checked').forEach(cb => {
                        selected.push(cb.value);
                    });

                    const columnString = selected.join(',');

                    const searchInput = document.querySelector('input[name="FilterClassName"]');
                    const filterClassName = encodeURIComponent(searchInput ? searchInput.value : '');

                    let url = `/Index?handler=ExportJson&isFiltered=${isFiltered}&selectedColumns=${columnString}`;
                    if (isFiltered && filterClassName) {
                        url += `&filterClassName=${filterClassName}`;
                    }

                    window.location.href = url;
                }
            </script>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> Class List</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped text-center">
                            <thead class="table-dark">
                                <tr>
                                    <th>Class Name</th>
                                    <th>Students</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.FilteredClasses)
                                {
                                    <tr>
                                        <td>@item.ClassName</td>
                                        <td>@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <a asp-page-handler="Edit" asp-route-id="@item.Id"
                                                class="btn btn-secondary btn-sm">
                                                Edit
                                            </a>
                                            <form method="post" asp-page-handler="Delete" class="d-inline"
                                                onsubmit="return confirm('Are you sure?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav>
                        <ul class="pagination justify-content-center">
                            @foreach (var page in Model.GetPaginationPages())
                            {
                                if (page is string)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                else
                                {
                                    int pageNumber = (int)page;
                                    bool isActive = pageNumber == Model.CurrentPage;

                                    <li class="page-item @(isActive ? "active" : "")">
                                        <a class="page-link"
                                            href="?CurrentPage=@pageNumber&FilterClassName=@Model.FilterClassName">
                                            @pageNumber
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>