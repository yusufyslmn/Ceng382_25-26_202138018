@page
@model week5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Add/Edit Class</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="EditId" />
                        <div class="mb-3">
                            <label class="form-label">Class Name</label>
                            <input type="text" class="form-control" asp-for="ClassInfo.ClassName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Student Count</label>
                            <input type="number" class="form-control" asp-for="ClassInfo.StudentCount" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" asp-for="ClassInfo.Description" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control"
                        placeholder="Search by class name..." />
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </form>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Class List</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Class Name</th>
                                    <th>Students</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.FilteredClasses)
                                {
                                    <tr>
                                        <td>@item.ClassName</td>
                                        <td>@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <a asp-page-handler="Edit" asp-route-id="@item.Id"
                                                class="btn btn-secondary btn-sm">
                                                Edit
                                            </a>
                                            <form method="post" asp-page-handler="Delete" class="d-inline"
                                                onsubmit="return confirm('Are you sure?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav>
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                        href="?CurrentPage=@i&FilterClassName=@Model.FilterClassName">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>